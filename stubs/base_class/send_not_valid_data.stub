/**
     * Sending invalid data from an authorized {{ studly_name }}
     *
     * @throws ReflectionException
     */
    public function testSendFrom{{ studly_name }}NotValidData(): void
    {
        if (! $this->checkContract(InvalidateContract::class)) {
            $this->markTestSkipped('Тест пропущен, так как вызываемый класс не реализует интерфейс передачи невалидных данных');
        }

        $this->callAuthorizedBy{{ studly_name }}RouteAction(
            $this->get{{ studly_name }}(),
            $this->getInvalidData('{{ name }}'),
            $this->getParameters('{{ name }}')
        )->assertStatus($this->getInvalidDataCode('{{ name }}'));
    }