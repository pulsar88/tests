/**
     * Executes a request transmitting invalid data from an authorized {{ studly_name }}
     *
     * @throws ReflectionException
     */
    public function testSendInvalidParametersFrom{{ studly_name }}(): void
    {
        if (! $this->checkContract(InvalidParametersContract::class)) {
            $this->markTestSkipped('Тест пропущен, так как вызываемый класс не реализует интерфейс передачи невалидных параметров');
        }

        $this->callAuthorizedBy{{ studly_name }}RouteAction(
            $this->get{{ studly_name }}(),
            $this->getValidData('{{ name }}'),
            $this->getInvalidParameters('{{ name }}')
        )->assertStatus($this->getInvalidParametersCode('{{ name }}'));
    }